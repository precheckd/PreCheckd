<style>
  .net-content { flex: 1; padding: 1.75rem 1.5rem; background: #1F363C; min-height: 100vh; }
  .net-wrap { max-width: 1200px; margin: 0 auto; }
  .net-wrap h1 { font-size: 1.6rem; color: #F2F4F3; margin-bottom: 1rem; }
  .net-tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid #3B5860; margin-bottom: 1.25rem; }
  .net-tab { padding: 0.65rem 1.1rem; color: #8FA6AC; text-decoration: none; font-weight: 600; font-size: 0.95rem; border-bottom: 3px solid transparent; margin-bottom: -1px; display: inline-flex; align-items: center; gap: 0.45rem; }
  .net-tab:hover { color: #F2F4F3; }
  .net-tab.is-on { color: #F2F4F3; border-bottom-color: #2ECC71; }
  .net-pill { background: #3B5860; color: #E8EBEA; font-size: 0.72rem; font-weight: 700; padding: 0 7px; line-height: 19px; border-radius: 10px; }
  .net-pill.alert { background: #E53E3E; }
  @media (max-width: 768px) { .net-content { padding: 1rem; } }
</style>

<div class="net-content">
  <div class="net-wrap">
    <h1>Connections</h1>
    <div class="net-tabs">
      <a href="/connections?tab=requests" class="net-tab<%= tab === 'requests' ? ' is-on' : '' %>">Requests<% if (waitingCount > 0) { %><span class="net-pill<%= pendingCount > 0 ? ' alert' : '' %>"><%= waitingCount %></span><% } %></a>
      <a href="/connections?tab=connections" class="net-tab<%= tab === 'connections' ? ' is-on' : '' %>">Connections<% if (connectionCount > 0) { %><span class="net-pill"><%= connectionCount %></span><% } %></a>
    </div>
    <% if (tab === 'requests') { %>
      <%- include(isCandidate ? 'candidate-requests' : 'recruiter-requests') %>
    <% } else { %>
      <%- include('connections-list') %>
    <% } %>
  </div>
</div>
