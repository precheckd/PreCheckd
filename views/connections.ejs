<style>
  .net-content { flex: 1; padding: 2rem 1.5rem; background: #1F363C; min-height: 100vh; }
  .net-head { max-width: 1400px; margin: 0 auto 1.25rem; }
  .net-head h1 { font-size: 1.75rem; color: #F2F4F3; margin-bottom: 0.35rem; }
  .net-head p { color: #C7D1CF; font-size: 0.95rem; }
  .net-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .net-col h2 { font-size: 1.1rem; color: #F2F4F3; margin: 0 0 0.35rem; display: flex; align-items: center; gap: 0.5rem; }
  .net-col h2 .net-count { background: #E53E3E; color: #F2F4F3; font-size: 0.75rem; font-weight: 700; padding: 0 7px; line-height: 20px; border-radius: 10px; }
  .net-col .net-sub { color: #8FA6AC; font-size: 0.85rem; margin: 0 0 1rem; }
  @media (max-width: 960px) {
    .net-content { padding: 1rem; }
    .net-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="net-content">
  <div class="net-head">
    <h1>Connections</h1>
    <p>Requests waiting on you on the left, your address book on the right.</p>
  </div>
  <div class="net-grid">
    <section class="net-col">
      <h2>Requests<% if (pendingCount > 0) { %><span class="net-count"><%= pendingCount %> new</span><% } %></h2>
      <p class="net-sub"><%= isCandidate ? "Recruiters who've reached out to you, and the status of requests you've sent." : 'Candidates who want to connect with you, and the status of requests you\'ve sent.' %></p>
      <%- include(isCandidate ? 'candidate-requests' : 'recruiter-requests') %>
    </section>
    <section class="net-col">
      <h2>Your connections</h2>
      <p class="net-sub"><%= isCandidate ? 'Recruiters you\'re connected with or have saved, each with a private note only you can see.' : 'Candidates you\'re connected with, each with a private note only you can see.' %></p>
      <%- include('connections-list') %>
    </section>
  </div>
</div>
