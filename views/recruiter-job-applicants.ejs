<%
  const fmt = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
%>
<style>
  .ja-wrap { flex: 1; padding: 2rem 1.5rem 4rem; background: #1F363C; min-height: 100vh; display: flex; justify-content: center; }
  .ja-inner { max-width: 1100px; width: 100%; color: #F2F4F3; }
  .ja-back { display: inline-block; margin-bottom: 1.25rem; color: #8FA6AC; font-size: 0.9rem; text-decoration: none; }
  .ja-inner h1 { font-size: 1.6rem; margin: 0 0 0.3rem; }
  .ja-howvid { margin: 0 0 1rem; background: #24404A; border: 1px solid #3B5860; border-radius: 8px; padding: 0.6rem 0.9rem; }
  .ja-howvid summary { cursor: pointer; font-weight: 700; color: #F2F4F3; }
  .ja-howvid video { display: block; width: 100%; max-width: 720px; aspect-ratio: 16 / 9; margin-top: 0.7rem; background: #1F363C; border-radius: 8px; }
  .ja-sub { color: #C7D1CF; margin-bottom: 1.25rem; }
  .ja-card { display: flex; justify-content: space-between; align-items: center; gap: 1rem; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 0.7rem; }
  .ja-name { font-weight: 700; }
  .ja-meta { color: #C7D1CF; font-size: 0.85rem; }
  .ja-btn { background: #2ECC71; color: #10261C; border-radius: 6px; padding: 0.5rem 1rem; font-weight: 700; text-decoration: none; font-size: 0.9rem; white-space: nowrap; }
  .ja-form { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .ja-form select, .ja-form button { background: #1F363C; color: #F2F4F3; border: 1px solid #4A6F7B; border-radius: 6px; padding: 0.35rem 0.5rem; font-size: 0.85rem; }
  .ja-form button { background: #24404A; cursor: pointer; }
  .ja-ok { background: #1E3B2C; border-left: 4px solid #2ECC71; color: #CFF3DD; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
  .ja-err { background: #3A2B2B; border-left: 4px solid #FF8A8A; color: #FFD6D6; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
  .ja-empty { color: #C7D1CF; background: #2A4750; border: 1px dashed #4A6F7B; border-radius: 8px; padding: 2rem; text-align: center; }
  .ja-scroll { overflow-x: auto; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; }
  .ja-table { width: 100%; border-collapse: collapse; min-width: 860px; }
  .ja-table th { text-align: left; background: #24404A; color: #C7D1CF; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.7rem 0.9rem; white-space: nowrap; }
  .ja-table th[data-sort] { cursor: pointer; user-select: none; }
  .ja-table th[data-sort]:hover { color: #F2F4F3; }
  .ja-table th .ja-arrow { display: inline-block; width: 0.8em; color: #2ECC71; }
  .ja-table td { padding: 0.7rem 0.9rem; border-top: 1px solid #3B5860; vertical-align: top; font-size: 0.9rem; }
  .ja-table .ja-form { margin-top: 0; }
  .ja-score { font-weight: 700; }
  .ja-fftoggle { display: block; margin-top: 0.35rem; background: none; border: none; padding: 0; color: #2ECC71; font-size: 0.82rem; cursor: pointer; text-decoration: underline; }
  .ja-ffrow td { background: #24404A; padding: 1.1rem 1.4rem 1.3rem; }
  .ja-ffhead { font-weight: 700; margin-bottom: 0.4rem; }
  .ja-ffq { margin-top: 0.9rem; color: #C7D1CF; font-size: 0.92rem; font-weight: 600; max-width: 860px; }
  .ja-ffa { white-space: pre-wrap; background: #1F363C; border-radius: 6px; padding: 0.9rem 1.1rem; margin-top: 0.35rem; font-size: 1rem; line-height: 1.6; max-width: 860px; min-height: 5rem; }
  .ja-fin { background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 1rem; }
  .ja-fin h2 { font-size: 1.05rem; margin: 0 0 0.4rem; }
  .ja-chip { display: inline-block; background: #1F363C; border: 1px solid #4A6F7B; border-radius: 999px; padding: 0.15rem 0.6rem; font-size: 0.82rem; margin: 0 0.3rem 0.3rem 0; }
  .ja-checks { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0.5rem 0; }
  .ja-checks label { font-size: 0.92rem; }
  .ja-decide { background: #3A3320; border-left: 4px solid #F2C14E; color: #FBEFC9; padding: 0.8rem 1rem; border-radius: 6px; margin-bottom: 0.6rem; display: flex; justify-content: space-between; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .ja-decide form { display: inline; }
  .ja-decide button { background: #1F363C; color: #F2F4F3; border: 1px solid #4A6F7B; border-radius: 6px; padding: 0.4rem 0.8rem; font-size: 0.85rem; cursor: pointer; margin-left: 0.3rem; }
  .ja-decide button.rej { border-color: #FF8A8A; color: #FFD6D6; }
  .ja-fbtn { background: #24404A; color: #F2F4F3; border: 1px solid #4A6F7B; border-radius: 6px; padding: 0.35rem 0.6rem; font-size: 0.82rem; cursor: pointer; }
  .ja-fbtn[disabled] { opacity: 0.5; cursor: not-allowed; }
</style>
<div class="ja-wrap"><div class="ja-inner">
  <a class="ja-back" href="/recruiter-jobs/<%= posting._id %>">&larr; Back to this posting</a>
  <h1>Applicants</h1>
  <details class="ja-howvid">
    <summary>Watch how to review applicants</summary>
    <video controls playsinline preload="none" aria-label="How to review applicants on PreCheckd">
      <source src="https://precheckd-marketing.s3.us-east-2.amazonaws.com/videos/Pre+Checkd+03+Review+Applicants.mp4" type="video/mp4">
      Your browser can't play this video.
    </video>
  </details>
  <p class="ja-sub"><%= posting.title %> &middot; <%= posting.hiringCompany %>. Everyone here met every requirement. Their full profile, video and resume stay open to you until you decide not to move forward. The candidate sees the reason you pick, so choose the one that is true.</p>
  <p class="ja-sub" style="margin-top:-0.4rem;"><strong><%= queue.waiting %> of <%= queue.limit %></strong> waiting on a decision. New applications pause at <%= queue.limit %>. Moving someone to Screening does not clear a place; interviewing, hiring or not moving forward does.</p>
  <% if (moved) { %><div class="ja-ok">Updated. The candidate has been told.</div><% } %>
  <% if (error) { %><div class="ja-err"><%= error %></div><% } %>
  <% const fmsg = { topics: 'Finalist topics saved. They are locked once you send the first invite.', sent: 'Finalist test sent. They have ' + finalist.hours + ' hours to start it.', auto_on: 'Auto-reject is on for this posting.', auto_off: 'Auto-reject is off. You will decide about anyone who does not finish.', kept: 'Kept. They stay in your pipeline.', rejected: 'Updated. The candidate has been told.' }[finalistMsg]; %>
  <% if (fmsg) { %><div class="ja-ok"><%= fmsg %></div><% } %>

  <div class="ja-fin">
    <h2>Finalist tests</h2>
    <% if (finalist.topics.length !== finalist.pickCount) { %>
      <p class="ja-meta" style="margin:0 0 0.5rem;">Invite up to <%= finalist.slots.total %> of your applicants to one short second-stage assessment. Pick exactly <%= finalist.pickCount %> topics for this posting. There is no extra charge. Once you send the first invite, the topics are locked.</p>
      <form method="POST" action="/recruiter-jobs/<%= posting._id %>/finalist/topics">
        <div class="ja-checks">
          <% finalistTopics.forEach(function(t) { %><label><input type="checkbox" name="finalistTopics" value="<%= t.key %>"> <%= t.label %></label><% }); %>
        </div>
        <button class="ja-fbtn" type="submit">Save topics</button>
      </form>
    <% } else { %>
      <div><% finalist.topics.forEach(function(k) { %><span class="ja-chip"><%= finalistLabel(k) %></span><% }); %><span class="ja-meta"><%= finalist.locked ? 'Locked' : 'Locked after your first invite' %></span></div>
      <p class="ja-meta" style="margin:0.2rem 0 0.6rem;"><strong><%= finalist.slots.used %> of <%= finalist.slots.total %></strong> finalist slots in use. A slot comes back if a finalist declines, runs out of <%= finalist.hours %> hours, or the attempt is not verified. Send invites from the Finalist column below.</p>
      <form method="POST" action="/recruiter-jobs/<%= posting._id %>/finalist/auto-reject" class="ja-form" style="margin-top:0;">
        <input type="hidden" name="on" value="<%= finalist.autoReject ? '0' : '1' %>">
        <span class="ja-meta">Auto-reject people who do not finish: <strong><%= finalist.autoReject ? 'ON' : 'OFF' %></strong>. <%= finalist.autoReject ? 'They are rejected automatically with the reason "the finalist assessment was not completed."' : 'You choose what happens to each of them.' %></span>
        <button class="ja-fbtn" type="submit"><%= finalist.autoReject ? 'Turn off' : 'Turn on' %></button>
      </form>
    <% } %>
  </div>

  <% applicants.forEach(function(a) { const f = finalist.byApp.get(String(a._id)); if (f && f.needsDecision && live.indexOf(a.status) !== -1) { %>
    <div class="ja-decide">
      <div><strong><%= a.candidateId.firstName %> <%= a.candidateId.lastName %></strong> <%= f.status === 'declined' ? 'declined' : f.status === 'expired' ? 'did not start in time for' : 'did not complete' %> the finalist test. Their slot is back. You decide: keep them in your pipeline, or reject them. They are not rejected unless you choose to.</div>
      <div>
        <form method="POST" action="/recruiter-jobs/<%= posting._id %>/finalist/<%= f.id %>/decide"><input type="hidden" name="choice" value="keep"><button type="submit">Keep</button></form>
        <form method="POST" action="/recruiter-jobs/<%= posting._id %>/finalist/<%= f.id %>/decide"><input type="hidden" name="choice" value="reject"><button class="rej" type="submit">Reject (they see: &ldquo;The finalist assessment was not completed.&rdquo;)</button></form>
      </div>
    </div>
  <% } }); %>
  <% if (applicants.length === 0) { %>
    <div class="ja-empty">No applicants yet.</div>
  <% } %>
  <% if (applicants.length) { %>
  <div class="ja-scroll"><table class="ja-table" id="ja-table">
    <thead><tr>
      <th data-sort="text">Name <span class="ja-arrow"></span></th>
      <th data-sort="num">Applied <span class="ja-arrow"></span></th>
      <th data-sort="text">Stage <span class="ja-arrow"></span></th>
      <th data-sort="num">Job test <span class="ja-arrow"></span></th>
      <th>Finalist</th>
      <th>Decision</th>
      <th></th>
    </tr></thead>
    <tbody>
    <% applicants.forEach(function(a) { const c = a.candidateId; const isLive = live.indexOf(a.status) !== -1;
         const score = a.roleTestResult && a.roleTestResult.score != null ? Math.round(a.roleTestResult.score) : null;
         const hasFF = !!(a.roleTestResult && a.roleTestResult.freeForm && a.roleTestResult.freeForm.length); %>
      <tr>
        <td data-v="<%= (c.lastName + ' ' + c.firstName).toLowerCase() %>"><span class="ja-name"><%= c.firstName %> <%= c.lastName %></span></td>
        <td data-v="<%= new Date(a.appliedAt).getTime() %>"><%= fmt(a.appliedAt) %></td>
        <td data-v="<%= (stages[a.status] || a.status).toLowerCase() %>"><strong><%= stages[a.status] || a.status %></strong></td>
        <td data-v="<%= score === null ? '' : score %>">
          <% if (score !== null) { %><span class="ja-score"><%= score %>%</span>
          <% } else if (a.roleTestResult) { %><span class="ja-score">Scored</span>
          <% } else if (a.roleTestStatus === 'waiting') { %><span class="ja-meta">Being prepared</span>
          <% } else if (a.roleTestStatus === 'ready') { %><span class="ja-meta">Sent, not finished</span>
          <% } else { %><span class="ja-meta">&ndash;</span><% } %>
          <% if (hasFF) { %><button type="button" class="ja-fftoggle" aria-expanded="false">Written answers</button><% } %>
        </td>
        <td>
          <% const f = finalist.byApp.get(String(a._id)); %>
          <% if (f && f.status === 'completed') { %>
            <span class="ja-score"><%= f.score == null ? 'Scored' : Math.round(f.score) + '%' %></span>
            <% if (f.topicScores.length) { %><div class="ja-meta"><%= f.topicScores.map(function(t) { return finalistLabel(t.key) + ' ' + Math.round(t.score) + '%'; }).join(' · ') %></div><% } %>
          <% } else if (f && f.status === 'sent') { %><span class="ja-meta">Invited, they have until <%= new Date(f.expiresAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }) %> ET</span>
          <% } else if (f && f.status === 'accepted') { %><span class="ja-meta">In progress</span>
          <% } else if (f) { %><span class="ja-meta"><%= f.status === 'declined' ? 'Declined' : f.status === 'expired' ? 'Ran out of time' : 'Not completed' %><%= f.decision === 'kept' ? ' &middot; kept' : f.decision === 'rejected' ? ' &middot; rejected' : '' %></span>
          <% } %>
          <% if (isLive && finalist.topics.length === finalist.pickCount && (!f || ['declined','expired','failed'].indexOf(f.status) !== -1)) { %>
            <form method="POST" action="/recruiter-jobs/<%= posting._id %>/applicants/<%= a._id %>/finalist" style="margin-top:0.3rem;">
              <button class="ja-fbtn" type="submit" <%= finalist.slots.left < 1 ? 'disabled title="All finalist slots are in use"' : '' %>><%= f ? 'Send again' : 'Send finalist test' %></button>
            </form>
          <% } %>
        </td>
        <td>
          <% if (isLive) { %>
          <form class="ja-form" method="POST" action="/recruiter-jobs/<%= posting._id %>/applicants/<%= a._id %>/stage">
            <select name="stage" aria-label="Move to">
              <% Object.keys(stages).forEach(function(k) { if (k !== a.status) { %><option value="<%= k %>"><%= k === 'rejected' ? 'Not moving forward' : stages[k] %></option><% } }); %>
            </select>
            <select name="reason" aria-label="Area for them to work on (needed for not moving forward)">
              <option value="">Area to work on (for not moving forward)</option>
              <% reasons.filter(function(r) { return !r.finalistOnly && (!r.stages || r.stages.includes(a.status)) && (!r.needsRoleTest || a.roleTestResult); }).forEach(function(r) { %><option value="<%= r.code %>"><%= r.label %></option><% }); %>
            </select>
            <button type="submit">Move</button>
          </form>
          <% } %>
        </td>
        <td><% if (a.connectionId && isLive) { %><a class="ja-btn" href="/recruiter-dashboard/requests/<%= a.connectionId %>/candidate">View profile</a><% } %></td>
      </tr>
      <% if (hasFF) { %>
      <tr class="ja-ffrow" hidden><td colspan="7">
        <div class="ja-ffhead">Written answers &middot; <%= c.firstName %> <%= c.lastName %></div>
        <% a.roleTestResult.freeForm.forEach(function(f, i) { %>
          <div class="ja-ffq"><%= i + 1 %>. <%= f.question %></div>
          <div class="ja-ffa"><%= f.answer %></div>
        <% }); %>
      </td></tr>
      <% } %>
    <% }); %>
    </tbody>
  </table></div>
  <script src="/js/applicant-table.js"></script>
  <% } %>
</div></div>
