<%
  const fmt = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
%>
<style>
  .ja-wrap { flex: 1; padding: 2rem 1.5rem 4rem; background: #1F363C; min-height: 100vh; display: flex; justify-content: center; }
  .ja-inner { max-width: 1100px; width: 100%; color: #F2F4F3; }
  .ja-back { display: inline-block; margin-bottom: 1.25rem; color: #8FA6AC; font-size: 0.9rem; text-decoration: none; }
  .ja-inner h1 { font-size: 1.6rem; margin: 0 0 0.3rem; }
  .ja-sub { color: #C7D1CF; margin-bottom: 1.25rem; }
  .ja-card { display: flex; justify-content: space-between; align-items: center; gap: 1rem; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 0.7rem; }
  .ja-name { font-weight: 700; }
  .ja-meta { color: #C7D1CF; font-size: 0.85rem; }
  .ja-btn { background: #2ECC71; color: #10261C; border-radius: 6px; padding: 0.5rem 1rem; font-weight: 700; text-decoration: none; font-size: 0.9rem; white-space: nowrap; }
  .ja-form { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .ja-form select, .ja-form button { background: #1F363C; color: #F2F4F3; border: 1px solid #4A6F7B; border-radius: 6px; padding: 0.35rem 0.5rem; font-size: 0.85rem; }
  .ja-form button { background: #24404A; cursor: pointer; }
  .ja-ok { background: #1E3B2C; border-left: 4px solid #2ECC71; color: #CFF3DD; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
  .ja-err { background: #3A2B2B; border-left: 4px solid #FF8A8A; color: #FFD6D6; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
  .ja-empty { color: #C7D1CF; background: #2A4750; border: 1px dashed #4A6F7B; border-radius: 8px; padding: 2rem; text-align: center; }
  .ja-scroll { overflow-x: auto; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; }
  .ja-table { width: 100%; border-collapse: collapse; min-width: 860px; }
  .ja-table th { text-align: left; background: #24404A; color: #C7D1CF; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.7rem 0.9rem; white-space: nowrap; }
  .ja-table th[data-sort] { cursor: pointer; user-select: none; }
  .ja-table th[data-sort]:hover { color: #F2F4F3; }
  .ja-table th .ja-arrow { display: inline-block; width: 0.8em; color: #2ECC71; }
  .ja-table td { padding: 0.7rem 0.9rem; border-top: 1px solid #3B5860; vertical-align: top; font-size: 0.9rem; }
  .ja-table .ja-form { margin-top: 0; }
  .ja-score { font-weight: 700; }
</style>
<div class="ja-wrap"><div class="ja-inner">
  <a class="ja-back" href="/recruiter-jobs/<%= posting._id %>">&larr; Back to this posting</a>
  <h1>Applicants</h1>
  <p class="ja-sub"><%= posting.title %> &middot; <%= posting.hiringCompany %>. Everyone here met every requirement. Their full profile, video and resume stay open to you until you decide not to move forward. The candidate sees the reason you pick, so choose the one that is true.</p>
  <p class="ja-sub" style="margin-top:-0.4rem;"><strong><%= queue.waiting %> of <%= queue.limit %></strong> waiting on a decision. New applications pause at <%= queue.limit %>. Moving someone to Screening does not clear a place; interviewing, hiring or not moving forward does.</p>
  <% if (moved) { %><div class="ja-ok">Updated. The candidate has been told.</div><% } %>
  <% if (error) { %><div class="ja-err"><%= error %></div><% } %>
  <% if (applicants.length === 0) { %>
    <div class="ja-empty">No applicants yet.</div>
  <% } %>
  <% if (applicants.length) { %>
  <div class="ja-scroll"><table class="ja-table" id="ja-table">
    <thead><tr>
      <th data-sort="text">Name <span class="ja-arrow"></span></th>
      <th data-sort="num">Applied <span class="ja-arrow"></span></th>
      <th data-sort="text">Stage <span class="ja-arrow"></span></th>
      <th data-sort="num">Job test <span class="ja-arrow"></span></th>
      <th>Decision</th>
      <th></th>
    </tr></thead>
    <tbody>
    <% applicants.forEach(function(a) { const c = a.candidateId; const isLive = live.indexOf(a.status) !== -1;
         const score = a.roleTestResult && a.roleTestResult.score != null ? Math.round(a.roleTestResult.score) : null; %>
      <tr>
        <td data-v="<%= (c.lastName + ' ' + c.firstName).toLowerCase() %>"><span class="ja-name"><%= c.firstName %> <%= c.lastName %></span></td>
        <td data-v="<%= new Date(a.appliedAt).getTime() %>"><%= fmt(a.appliedAt) %></td>
        <td data-v="<%= (stages[a.status] || a.status).toLowerCase() %>"><strong><%= stages[a.status] || a.status %></strong></td>
        <td data-v="<%= score === null ? '' : score %>">
          <% if (score !== null) { %><span class="ja-score"><%= score %>%</span>
          <% } else if (a.roleTestResult) { %><span class="ja-score">Scored</span>
          <% } else if (a.roleTestStatus === 'waiting') { %><span class="ja-meta">Being prepared</span>
          <% } else if (a.roleTestStatus === 'ready') { %><span class="ja-meta">Sent, not finished</span>
          <% } else { %><span class="ja-meta">&ndash;</span><% } %>
        </td>
        <td>
          <% if (isLive) { %>
          <form class="ja-form" method="POST" action="/recruiter-jobs/<%= posting._id %>/applicants/<%= a._id %>/stage">
            <select name="stage" aria-label="Move to">
              <% Object.keys(stages).forEach(function(k) { if (k !== a.status) { %><option value="<%= k %>"><%= k === 'rejected' ? 'Not moving forward' : stages[k] %></option><% } }); %>
            </select>
            <select name="reason" aria-label="Area for them to work on (needed for not moving forward)">
              <option value="">Area to work on (for not moving forward)</option>
              <% reasons.filter(function(r) { return (!r.stages || r.stages.includes(a.status)) && (!r.needsRoleTest || a.roleTestResult); }).forEach(function(r) { %><option value="<%= r.code %>"><%= r.label %></option><% }); %>
            </select>
            <button type="submit">Move</button>
          </form>
          <% } %>
        </td>
        <td><% if (a.connectionId && isLive) { %><a class="ja-btn" href="/recruiter-dashboard/requests/<%= a.connectionId %>/candidate">View profile</a><% } %></td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
  <script src="/js/applicant-table.js"></script>
  <% } %>
</div></div>
