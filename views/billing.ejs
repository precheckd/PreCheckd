<style>
  .bl-wrap { flex: 1; padding: 3rem 1.5rem; background: #1F363C; min-height: 70vh; display: flex; justify-content: center; }
  .bl-card { max-width: 640px; width: 100%; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 2rem; color: #F2F4F3; }
  .bl-card h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
  .bl-card p { color: #C7D1CF; line-height: 1.5; }
  .bl-banner { border-radius: 8px; padding: .75rem 1rem; margin: 0 0 1rem; }
  .bl-warn { background: #3a3320; border: 1px solid #6b5d2a; color: #f2e6b8; }
  .bl-ok { background: #1d3b2a; border: 1px solid #2c6b45; color: #bdecd0; }
  .bl-plans { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.25rem 0; }
  @media (max-width: 560px) { .bl-plans { grid-template-columns: 1fr; } }
  .bl-plan { border: 1px solid #3B5860; border-radius: 8px; padding: 1.1rem; background: #23404a; }
  .bl-plan h2 { margin: 0 0 .25rem; font-size: 1.05rem; }
  .bl-price { font-size: 1.6rem; font-weight: 700; margin: .25rem 0; }
  .bl-price small { font-size: .85rem; font-weight: 400; color: #C7D1CF; }
  .bl-tag { display: inline-block; background: #2ECC71; color: #10261b; border-radius: 999px; font-size: .75rem; font-weight: 700; padding: .15rem .6rem; margin-bottom: .4rem; }
  .bl-btn { display: inline-block; background: #2ECC71; color: #10261b; border: 0; border-radius: 6px; padding: .6rem 1.1rem; font-weight: 700; cursor: pointer; font-size: 1rem; }
  .bl-ghost { background: transparent; color: #F2F4F3; border: 1px solid #5b7a82; }
  .bl-meta { color: #C7D1CF; font-size: .9rem; }
  .bl-plan form { margin-top: .75rem; }

  .bl-plan.bl-hero { border: 2px solid #2ECC71; background: #1b3a2b; box-shadow: 0 0 0 3px rgba(46,204,113,.18); text-align: center; }
  .bl-special { display: inline-block; background: #E5252A; color: #fff; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; font-size: .95rem; padding: .35rem .8rem; border-radius: 4px; margin: .35rem 0 .2rem; }
  .bl-was { position: relative; display: inline-block; font-size: 2rem; font-weight: 800; color: #C7D1CF; padding: 0 .6rem; margin: .5rem 0 .8rem; }
  .bl-was::before, .bl-was::after { content: ''; position: absolute; left: -2px; right: -2px; top: 50%; height: 5px; background: #FF2A2A; border-radius: 3px; }
  .bl-was::before { transform: rotate(18deg); } .bl-was::after { transform: rotate(-18deg); }
  .bl-was small { font-size: 1rem; font-weight: 600; }
  .bl-now { font-size: 3.2rem; font-weight: 900; line-height: 1; color: #2ECC71; margin: .35rem 0 .1rem; }
  .bl-now small { font-size: 1.1rem; font-weight: 700; color: #F2F4F3; }
  .bl-left { color: #FFD23F; font-weight: 800; font-size: 1.05rem; margin: .4rem 0; }
  .bl-ladder { margin: .9rem 0 .3rem; border-top: 1px dashed #5b7a82; padding-top: .7rem; font-size: .9rem; text-align: left; }
  .bl-ladder div { display: flex; justify-content: space-between; padding: .15rem 0; color: #C7D1CF; }
  .bl-ladder .bl-cur { color: #fff; font-weight: 800; }
  .bl-hero .bl-btn { width: 100%; font-size: 1.15rem; padding: .8rem 1rem; }
  .bl-plans.bl-stack { grid-template-columns: 1fr; }
</style>
<div class="bl-wrap"><div class="bl-card">
  <h1>Membership</h1>
  <% if (!enabled) { %>
    <p>Membership billing isn't switched on yet. Nothing is charged.</p>
  <% } else { %>
    <% if (needed) { %><div class="bl-banner bl-warn">Your membership isn't active. Start or renew it to post jobs, search candidates and reach applicants.</div><% } %>
    <% if (canceled) { %><div class="bl-banner bl-warn">Checkout was cancelled. You have not been charged.</div><% } %>
    <% if (error === 'invite') { %><div class="bl-banner bl-warn">That invite code isn't valid, or it was already used.</div>
    <% } else if (error === 'invite_full') { %><div class="bl-banner bl-warn">The founding invite spots are full. You can still join below.</div>
    <% } else if (error) { %><div class="bl-banner bl-warn">Something went wrong. Please try again, or contact support.</div><% } %>
    <% if (paid && state.status === 'active') { %><div class="bl-banner bl-ok">Thanks, you're a member.</div><% } %>

    <% if (state.status === 'active') { %>
      <p>Your <%= billing.plan === 'annual' ? 'annual' : 'monthly' %> plan is active<% if (billing.currentPeriodEnd) { %> through <%= new Date(billing.currentPeriodEnd).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }) %><% } %>.
        <% if (billing.cancelAtPeriodEnd) { %>It will end then and won't renew.<% } else { %>It renews automatically.<% } %></p>
      <% if (billing.founding && billing.founding.lockedAt && billing.founding.priceCents) { %><% if (billing.founding.locked) { %><p class="bl-meta">Founding recruiter: your price is locked at $<%= (billing.founding.priceCents / 100).toLocaleString('en-US') %>/year while you stay subscribed.</p><% } else { %><p class="bl-meta">Early Access: your first year was $<%= (billing.founding.priceCents / 100).toLocaleString('en-US') %>. After that it renews at the standard <%= annual %>/year.</p><% } %><% } %>
      <p class="bl-meta">Includes <%= limit %> open job postings at a time.</p>
      <% if (freeYear) { %>
        <div class="bl-banner <%= freeYear.status === 'warned' ? 'bl-warn' : 'bl-ok' %>" style="margin-top:1rem;">
          <strong>Free founding year</strong> until <%= new Date(freeYear.trialEnd).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>, then $349 a year, locked in.<br>
          Jobs posted: <%= freeYear.posted %> of <%= freeYear.postedTarget %><% if (!freeYear.postedMet && freeYear.postByDate) { %> (by <%= new Date(freeYear.postByDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>)<% } %>.
          <% if (freeYear.postedMet) { %>Jobs maintained now: <%= freeYear.maintained %> (keep at least <%= freeYear.maintainedTarget %>).<% } %>
          <% if (freeYear.status === 'warned' && freeYear.cureBy) { %><br><strong>Fix this by <%= new Date(freeYear.cureBy).toLocaleDateString('en-US', { month: 'long', day: 'numeric' }) %></strong> or your card is charged $349 and your paid year starts.<% } %>
        </div>
      <% } %>
    <% } else if (state.status === 'grace') { %>
      <div class="bl-banner bl-warn">Your last payment didn't go through. Update your card within <%= graceDays %> day<%= graceDays === 1 ? '' : 's' %> to keep your account active.</div>
    <% } else { %>
      <p>One plan, everything included: post up to 5 open jobs at a time, search verified candidates, and reach your applicants.</p>
      <% if (invite) { %>
        <div class="bl-plan bl-hero" style="text-align:left;">
          <span class="bl-special" style="background:#F5C518;color:#1F363C;">Founding invite</span>
          <div class="bl-now" style="margin-top:.6rem;">Free <small>for your first year</small></div>
          <p class="bl-meta" style="color:#F2F4F3;">Then $349 a year, locked in for as long as you stay a member. Cancel any time during the free year and you won't be charged.</p>
          <ul class="bl-meta" style="padding-left:1.2rem;line-height:1.55;">
            <li>A card is required to start. Nothing is charged during the free year.</li>
            <li>Post at least 3 real jobs in your first 30 days, then keep at least 2 going. A job counts while it is open, or for 30 days after it closes as filled.</li>
            <li>If that slips, we email you first and give you 30 days to fix it. If it is still not fixed, your card is charged $349 and your paid year starts.</li>
          </ul>
          <form method="POST" action="/billing/checkout"><input type="hidden" name="interval" value="annual"><input type="hidden" name="invite" value="1"><button class="bl-btn" type="submit">Start my free year</button></form>
        </div>
      <% } else { %>
      <div class="bl-plans">
        <div class="bl-plan">
          <h2>Monthly</h2>
          <div class="bl-price"><%= monthly %> <small>/month</small></div>
          <p class="bl-meta">Cancel any time. Sales tax added where it applies.</p>
          <form method="POST" action="/billing/checkout"><input type="hidden" name="interval" value="monthly"><button class="bl-btn bl-ghost" type="submit">Choose monthly</button></form>
        </div>
        <% if (wave.wave && !hadFounding) { %>
        <div class="bl-plan bl-hero">
          <h2>Annual</h2>
          <div class="bl-was"><%= annual %> <small>/year</small></div><br>
          <span class="bl-special"><%= wave.locked ? 'Founding Member Special' : 'Early Access Special' %></span>
          <div class="bl-now"><%= foundingPrice %> <small><%= wave.locked ? '/year' : 'first year' %></small></div>
          <div class="bl-left">Only <%= wave.spotsLeft %> spot<%= wave.spotsLeft === 1 ? '' : 's' %> left at this price</div>
          <p class="bl-meta"><% if (wave.locked) { %>Price locked in for as long as you stay subscribed. <strong style="color:#fff;letter-spacing:.04em;">FIRST 250 RECRUITERS ONLY.</strong><% } else { %>Then it renews at the standard <%= annual %>/year unless you cancel. We email you before it renews.<% } %></p>
          <div class="bl-ladder">
            <% ladder.forEach(function (l, i) { %><div class="<%= i === 0 ? 'bl-cur' : '' %>"><span><%= i === 0 ? 'Now' : 'Next' %> · <%= l.label %></span><span><%= l.price %> · <%= l.left %> left</span></div><% }) %>
            <div><span>After that · standard</span><span><%= annual %></span></div>
          </div>
          <form method="POST" action="/billing/checkout"><input type="hidden" name="interval" value="annual"><button class="bl-btn" type="submit">Claim this price</button></form>
        </div>
        <% } else { %>
        <div class="bl-plan">
          <h2>Annual</h2>
          <div class="bl-price"><%= annual %> <small>/year</small></div>
          <p class="bl-meta">Best value. Sales tax added where it applies.</p>
          <form method="POST" action="/billing/checkout"><input type="hidden" name="interval" value="annual"><button class="bl-btn" type="submit">Choose annual</button></form>
        </div>
        <% } %>
      </div>
      <% } %>
      <details style="margin-top:1rem;"><summary class="bl-meta" style="cursor:pointer;">Have an invite code?</summary>
        <form method="POST" action="/billing/invite" style="margin-top:.6rem;display:flex;gap:.5rem;flex-wrap:wrap;">
          <input type="text" name="code" maxlength="12" autocomplete="off" placeholder="Invite code" style="flex:1;min-width:10rem;padding:.5rem;border-radius:6px;border:1px solid #5b7a82;background:#1F363C;color:#F2F4F3;">
          <button class="bl-btn bl-ghost" type="submit">Use code</button>
        </form>
        <p class="bl-meta" style="margin-top:.6rem;"><a href="/request-invite" style="color:#8FE3B1;">Request an invite</a></p>
      </details>
    <% } %>

    <% if (state.status === 'active' || state.status === 'grace') { %>
      <% const msgs = { slots: 'Your extra slots are updated.', packs_done: 'Thanks, your test credits are added.', not_member: 'Start your membership first.', bad_quantity: 'Please choose a valid number.', in_use: 'Close some postings first: you have more open than that.' }; %>
      <% if (notice && msgs[notice]) { %><div class="bl-banner <%= (notice === 'slots' || notice === 'packs_done') ? 'bl-ok' : 'bl-warn' %>"><%= msgs[notice] %></div><% } %>
      <div class="bl-plans" style="margin-top:1.5rem;">
        <div class="bl-plan">
          <h2>Extra open postings</h2>
          <p class="bl-meta">Your plan includes 5. Add more by the month: $10 each for slots 1-5, $8 for 6-10, $6 from 11. Billed separately and prorated. You have <%= addons.slotQty %> extra now (<%= addons.slotCost %>/month).</p>
          <form method="POST" action="/billing/slots">
            <input type="number" name="quantity" min="0" max="<%= addons.maxSlots %>" value="<%= addons.slotQty %>" style="width:5rem;padding:.4rem;border-radius:6px;border:1px solid #5b7a82;background:#1F363C;color:#F2F4F3;">
            <button class="bl-btn bl-ghost" type="submit"><%= addons.slotQty ? 'Update slots' : 'Add slots' %></button>
          </form>
        </div>
        <div class="bl-plan">
          <h2>Job title test credits</h2>
          <p class="bl-meta">You get a monthly allowance. Need more? A pack of <%= addons.perPack %> is <%= addons.packCost %> and the credits never expire. You have <%= addons.credits.left %> left now.</p>
          <form method="POST" action="/billing/packs">
            <input type="number" name="packs" min="1" max="<%= addons.maxPacks %>" value="1" style="width:5rem;padding:.4rem;border-radius:6px;border:1px solid #5b7a82;background:#1F363C;color:#F2F4F3;">
            <button class="bl-btn bl-ghost" type="submit">Buy packs</button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (billing.customerId) { %>
      <form method="POST" action="/billing/portal"><button class="bl-btn bl-ghost" type="submit">Manage card, invoices or cancel</button></form>
    <% } %>
  <% } %>
</div></div>
