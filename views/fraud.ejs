<style>
  .fraud-hero {
    background: #1F363C;
    color: #F2F4F3;
    padding: 3rem 1.5rem;
  }

  .fraud-hero-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .fraud-hero h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .fraud-hero p {
    color: #B0C4CE;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .fraud-body {
    max-width: 800px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .fraud-section-title {
    font-size: 1.3rem;
    color: #1F363C;
    margin-bottom: 1rem;
  }

  .fraud-form {
    background: #F7F9F8;
    border: 1px solid #DCE4E2;
    border-radius: 8px;
    padding: 2rem;
  }

  .fraud-field {
    margin-bottom: 1.25rem;
  }

  .fraud-field label {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    color: #1F363C;
    margin-bottom: 0.4rem;
  }

  .fraud-field .fraud-hint {
    font-weight: 400;
    color: #7A8B91;
    font-size: 0.8rem;
  }

  .fraud-field input[type="email"],
  .fraud-field input[type="datetime-local"],
  .fraud-field select,
  .fraud-field textarea,
  .fraud-field input[type="file"] {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid #C7D1CF;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    box-sizing: border-box;
  }

  .fraud-field textarea {
    min-height: 100px;
    resize: vertical;
  }

  .fraud-submit-btn {
    background: #2ECC71;
    color: #1F363C;
    border: none;
    border-radius: 6px;
    padding: 0.85rem 1.75rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  .fraud-submit-btn:hover {
    background: #4ADE80;
  }

  .fraud-alert {
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .fraud-alert-error {
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.4);
    color: #B91C1C;
  }

  .fraud-success {
    background: #F7F9F8;
    border: 1px solid #DCE4E2;
    border-radius: 8px;
    padding: 2rem;
  }

  .fraud-success h2 {
    color: #1F7A4C;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .fraud-success-steps {
    margin: 1.25rem 0;
    padding-left: 0;
    list-style: none;
    counter-reset: fraud-step;
  }

  .fraud-success-steps li {
    counter-increment: fraud-step;
    position: relative;
    padding-left: 2.25rem;
    margin-bottom: 1rem;
    color: #4A5A5F;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .fraud-success-steps li::before {
    content: counter(fraud-step);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.6rem;
    height: 1.6rem;
    background: #2ECC71;
    color: #1F363C;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fraud-coupon-box {
    background: #1F363C;
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    text-align: center;
  }

  .fraud-coupon-label {
    color: #B0C4CE;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
  }

  .fraud-coupon-code {
    color: #4ADE80;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-family: "Courier New", monospace;
    margin-bottom: 0.6rem;
  }

  .fraud-coupon-note {
    color: #7A9B8E;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .fraud-cta {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid #DCE4E2;
  }

  .fraud-cta p {
    color: #4A5A5F;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .fraud-cta-link {
    display: inline-block;
    background: #1F363C;
    color: #F2F4F3;
    text-decoration: none;
    padding: 0.7rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-right: 0.75rem;
  }

  .fraud-cta-link:hover {
    background: #2A4750;
  }

  .fraud-gate-note {
    color: #7A8B91;
    font-size: 0.85rem;
    margin-top: 0.5rem;
    line-height: 1.5;
  }

  .fraud-send-code-btn {
    background: #1F363C;
    color: #F2F4F3;
    border: none;
    border-radius: 6px;
    padding: 0.65rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 0.75rem;
  }

  .fraud-send-code-btn:hover {
    background: #2A4750;
  }

  .fraud-send-code-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .fraud-inline-msg {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .fraud-inline-msg.is-error { color: #B91C1C; }
  .fraud-inline-msg.is-success { color: #1F7A4C; }

  .fraud-field input[readonly] {
    background: #EEF2F1;
    color: #4A5A5F;
  }

  .fraud-field .fraud-link {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.82rem;
    color: #2A6F4D;
    text-decoration: none;
    cursor: pointer;
  }

  .fraud-field .fraud-link:hover {
    text-decoration: underline;
  }
</style>

<div class="fraud-hero">
  <div class="fraud-hero-container">
    <h1>Reporting Recruiter Fraud</h1>
    <p>PreCheckd verifies every recruiter's phone, email, government ID, facial recognition, and company domain before they can connect with candidates. But fraud doesn't only come from people already on our platform — scam job offers and phishing attempts happen everywhere.</p>
    <p>This page lets anyone report a suspicious recruiter, whether or not they've ever used PreCheckd. Reports build a database we use to flag bad actors, encourage unverified recruiters to prove they're legitimate, and — over time — push back against fraud across the industry, not just on our own site.</p>
  </div>
</div>

<div class="fraud-body">
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="fraud-alert fraud-alert-error"><%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="fraud-success">
      <h2>Thank you — your report has been submitted.</h2>
      <p>Here's what happens next:</p>
      <ol class="fraud-success-steps">
        <li>Your report is logged in our fraud database immediately and checked against every PreCheckd recruiter account.</li>
        <li>If it matches an existing account, that's flagged for review, and depending on the recruiter's verification status, we may reach out to them.</li>
        <li>Our team reviews new reports directly — this isn't fully automated yet, so a real person looks at what you submitted.</li>
      </ol>

      <% if (typeof couponCode !== 'undefined' && couponCode) { %>
        <div class="fraud-coupon-box">
          <div class="fraud-coupon-label">A thank-you for reporting</div>
          <div class="fraud-coupon-code"><%= couponCode %></div>
          <div class="fraud-coupon-note">Save this code — it's tied to your email and good for a discount on PreCheckd once our paid features launch. We'll let you know when it's ready to use.</div>
        </div>
      <% } %>

      <div class="fraud-cta">
        <p>While you're here — see how PreCheckd verifies every recruiter before they can reach candidates, and why that matters.</p>
        <a href="/candidate-landing" class="fraud-cta-link">For Candidates</a>
        <a href="/recruiter-search" class="fraud-cta-link">Browse Verified Recruiters</a>
      </div>
    </div>
  <% } else { %>

  <h2 class="fraud-section-title">Report a Recruiter</h2>

  <form class="fraud-form" action="/fraud/report" method="POST" enctype="multipart/form-data" id="fraudForm">

    <!-- Step 1: just prove you own the email you're reporting from -->
    <div class="fraud-field" id="fraudStepGate" <% if (step !== 'gate') { %>style="display:none;"<% } %>>
      <label for="reporterEmailGate">Your email address <span class="fraud-hint">(to verify you're not a bot — never published)</span></label>
      <input type="email" id="reporterEmailGate" placeholder="you@example.com" value="<%= formValues.reporterEmail || '' %>">
      <button type="button" class="fraud-send-code-btn" id="fraudSendCodeBtn">Send verification code</button>
      <div class="fraud-inline-msg" id="fraudGateMsg"></div>
    </div>

    <!-- Step 2: code + the rest of the report -->
    <div id="fraudStepVerify" <% if (step !== 'verify') { %>style="display:none;"<% } %>>
      <div class="fraud-field">
        <label for="reporterEmail">Your email address</label>
        <input type="email" id="reporterEmail" name="reporterEmail" readonly value="<%= formValues.reporterEmail || '' %>">
        <a href="#" class="fraud-link" id="fraudChangeEmailLink">Use a different email</a>
      </div>

      <div class="fraud-field">
        <label for="code">Verification code <span class="fraud-hint">(check your email — expires in 10 minutes)</span></label>
        <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6-digit code">
        <a href="#" class="fraud-link" id="fraudResendCodeLink">Resend code</a>
        <div class="fraud-inline-msg" id="fraudResendMsg"></div>
      </div>

      <div class="fraud-field">
        <label for="reportedEmail">Recruiter's email address</label>
        <input type="email" id="reportedEmail" name="reportedEmail" required placeholder="recruiter@company.com" value="<%= formValues.reportedEmail || '' %>">
      </div>

      <div class="fraud-field">
        <label for="incidentDate">Date/time this happened <span class="fraud-hint">(optional)</span></label>
        <input type="datetime-local" id="incidentDate" name="incidentDate" value="<%= formValues.incidentDate || '' %>">
      </div>

      <div class="fraud-field">
        <label for="reasonCategory">Reason</label>
        <select id="reasonCategory" name="reasonCategory" required>
          <option value="">Select a reason...</option>
          <option value="payment-request" <%= formValues.reasonCategory === 'payment-request' ? 'selected' : '' %>>Asked for payment or fees</option>
          <option value="sensitive-info-request" <%= formValues.reasonCategory === 'sensitive-info-request' ? 'selected' : '' %>>Requested SSN or bank info upfront</option>
          <option value="impersonation" <%= formValues.reasonCategory === 'impersonation' ? 'selected' : '' %>>Impersonating a real company</option>
          <option value="ghosting" <%= formValues.reasonCategory === 'ghosting' ? 'selected' : '' %>>Ghosted after connecting</option>
          <option value="other" <%= formValues.reasonCategory === 'other' ? 'selected' : '' %>>Other</option>
        </select>
      </div>

      <div class="fraud-field">
        <label for="description">What happened?</label>
        <textarea id="description" name="description" required placeholder="Describe what happened in your own words..."><%= formValues.description || '' %></textarea>
      </div>

      <div class="fraud-field">
        <label for="evidenceText">Paste the email or message content <span class="fraud-hint">(optional)</span></label>
        <textarea id="evidenceText" name="evidenceText" placeholder="Paste the suspicious email or message here..."><%= formValues.evidenceText || '' %></textarea>
      </div>

      <div class="fraud-field">
        <label for="evidenceScreenshot">Upload a screenshot or file <span class="fraud-hint">(optional, JPEG/PNG/WebP/PDF, max 5MB)</span></label>
        <input type="file" id="evidenceScreenshot" name="evidenceScreenshot" accept="image/jpeg,image/png,image/webp,application/pdf">
      </div>

      <button type="submit" class="fraud-submit-btn">Submit Report</button>
    </div>
  </form>

  <% } %>
</div>

<script>
(function () {
  var stepGate = document.getElementById('fraudStepGate');
  var stepVerify = document.getElementById('fraudStepVerify');
  var gateEmailInput = document.getElementById('reporterEmailGate');
  var verifyEmailInput = document.getElementById('reporterEmail');
  var sendBtn = document.getElementById('fraudSendCodeBtn');
  var gateMsg = document.getElementById('fraudGateMsg');
  var resendLink = document.getElementById('fraudResendCodeLink');
  var resendMsg = document.getElementById('fraudResendMsg');
  var changeEmailLink = document.getElementById('fraudChangeEmailLink');

  if (!stepGate || !stepVerify) return;

  function showMsg(el, text, isError) {
    el.textContent = text;
    el.className = 'fraud-inline-msg ' + (isError ? 'is-error' : 'is-success');
  }

  function requestCode(email, btn, msgEl, onSuccess) {
    var isButton = btn.tagName === 'BUTTON';
    if (isButton) btn.disabled = true;
    var originalText = btn.textContent;
    btn.textContent = 'Sending...';

    fetch('/fraud/request-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reporterEmail: email })
    })
      .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
      .then(function (result) {
        if (isButton) btn.disabled = false;
        btn.textContent = originalText;
        if (!result.ok) {
          showMsg(msgEl, result.data.error || 'Something went wrong. Please try again.', true);
          return;
        }
        showMsg(msgEl, 'Code sent — check your inbox.', false);
        if (onSuccess) onSuccess();
      })
      .catch(function () {
        if (isButton) btn.disabled = false;
        btn.textContent = originalText;
        showMsg(msgEl, 'Something went wrong. Please try again.', true);
      });
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', function () {
      var email = (gateEmailInput.value || '').trim();
      if (!email || email.indexOf('@') === -1) {
        showMsg(gateMsg, 'Please enter a valid email address.', true);
        return;
      }
      requestCode(email, sendBtn, gateMsg, function () {
        verifyEmailInput.value = email;
        stepGate.style.display = 'none';
        stepVerify.style.display = '';
        document.getElementById('code').focus();
      });
    });
  }

  if (resendLink) {
    resendLink.addEventListener('click', function (e) {
      e.preventDefault();
      requestCode(verifyEmailInput.value, resendLink, resendMsg);
    });
  }

  if (changeEmailLink) {
    changeEmailLink.addEventListener('click', function (e) {
      e.preventDefault();
      gateEmailInput.value = verifyEmailInput.value;
      stepVerify.style.display = 'none';
      stepGate.style.display = '';
      gateEmailInput.focus();
    });
  }
})();
</script>