<style>
  .id-wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .id-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .id-header h1 {
    color: #1F363C;
    font-size: 1.7rem;
  }

  .id-header a {
    color: #7A8B91;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .id-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .id-card {
    display: block;
    background: #F7F9F8;
    border: 1px solid #DCE4E2;
    border-radius: 10px;
    padding: 1.75rem;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .id-card:hover {
    border-color: #2ECC71;
    transform: translateY(-2px);
  }

  .id-card-title {
    color: #1F363C;
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .id-card-desc {
    color: #7A8B91;
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .id-card-stat {
    display: inline-block;
    background: rgba(46, 204, 113, 0.15);
    color: #1F7A4C;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.25rem 0.65rem;
    border-radius: 10px;
  }

  .id-card-stat.id-stat-alert {
    background: rgba(248, 113, 113, 0.15);
    color: #B91C1C;
  }
</style>

<div class="id-wrap">
  <div class="id-header">
    <h1>PreCheckd Internal</h1>
    <a href="/internal/logout">Log Out</a>
  </div>

  <div class="id-cards">
    <a class="id-card" href="/internal/verify">
      <div class="id-card-title">Candidate Verification</div>
      <div class="id-card-desc">Review and toggle verified status on candidate work history, education, and certifications.</div>
      <span class="id-card-stat"><%= candidateCount %> candidates with entries</span>
    </a>

    <a class="id-card" href="/internal/fraud">
      <div class="id-card-title">Fraud Dashboard</div>
      <div class="id-card-desc">Every reported email and domain, sorted worst-first, with individual report review and status tracking.</div>
      <span class="id-card-stat <%= flaggedCount > 0 ? 'id-stat-alert' : '' %>"><%= flaggedCount %> flagged</span>
    </a>

    <a class="id-card" href="/internal/disputes">
      <div class="id-card-title">Dispute Inbox</div>
      <div class="id-card-desc">Recruiters replying to the automated "a report was filed" notice — your morning check for anything that needs a response.</div>
      <span class="id-card-stat <%= disputeAttentionCount > 0 ? 'id-stat-alert' : '' %>"><%= disputeAttentionCount %> awaiting reply</span>
    </a>
  </div>
</div>