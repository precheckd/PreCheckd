<style>
  .mail-content {
    flex: 1;
    padding: 2rem 1.5rem;
    background: #1F363C;
    min-height: 100vh;
  }

  .mail-header {
    max-width: 1200px;
    margin: 0 auto 1.25rem;
  }

  .mail-header h1 {
    font-size: 1.75rem;
    color: #F2F4F3;
    margin-bottom: 0.35rem;
  }

  .mail-header p {
    color: #C7D1CF;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .mail-address {
    color: #4ADE80;
    font-weight: 600;
    word-break: break-all;
  }

  .mail-preview-note {
    max-width: 1200px;
    margin: 0 auto 1.25rem;
    padding: 0.7rem 0.9rem;
    background: #24404A;
    border: 1px dashed #4A6F7B;
    border-radius: 6px;
    color: #C7D1CF;
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .mail-banner {
    max-width: 1200px;
    margin: 0 auto 1.25rem;
    padding: 0.7rem 0.9rem;
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.45;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mail-banner.ok { background: #1E4A33; border: 1px solid #2ECC71; color: #BDF2D2; }
  .mail-banner form { margin: 0; }

  .banner-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 6px;
    border: 1px solid #2ECC71;
    background: transparent;
    color: #BDF2D2;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: inherit;
  }

  .banner-btn:hover { background: #2ECC71; color: #1F363C; }

  .mail-columns {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* Long previews are cut with an ellipsis; without this they widen the page. */
  .mail-column { min-width: 0; }

  .mail-column h2 {
    font-size: 1.1rem;
    color: #F2F4F3;
    margin-bottom: 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mail-column .column-note {
    color: #8FA6AC;
    font-size: 0.85rem;
    line-height: 1.4;
    margin-bottom: 0.85rem;
  }

  .column-count {
    display: inline-block;
    min-width: 1.2rem;
    padding: 0 0.4rem;
    background: #E53E3E;
    color: #fff;
    border-radius: 999px;
    font-size: 0.72rem;
    line-height: 1.2rem;
    text-align: center;
    font-weight: 700;
  }

  .column-count.quiet {
    background: #4A6F7B;
  }

  .verified-column h2 { color: #4ADE80; }

  .mail-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mail-row {
    min-width: 0;
    background: #2A4750;
    border: 1px solid #3B5860;
    border-radius: 8px;
    padding: 0.9rem 1.1rem;
    display: block;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .mail-row:hover { border-color: #2ECC71; }
  .mail-row.unread { border-left: 3px solid #2ECC71; }

  .mail-row-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .mail-row-name {
    color: #F2F4F3;
    font-weight: 600;
    font-size: 0.95rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mail-row.unread .mail-row-name { color: #4ADE80; }

  .mail-row-date {
    color: #8FA6AC;
    font-size: 0.8rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .mail-row-subject {
    color: #C7D1CF;
    font-size: 0.9rem;
    margin-top: 0.15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mail-row-preview {
    color: #8FA6AC;
    font-size: 0.85rem;
    margin-top: 0.15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row-tag {
    display: inline-block;
    margin-top: 0.4rem;
    margin-right: 0.35rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    border: 1px solid #4A6F7B;
    color: #C7D1CF;
  }

  .row-tag.verified { border-color: #2ECC71; color: #4ADE80; }
  .row-tag.member { border-color: #4A6F7B; color: #C7D1CF; }

  .mail-empty {
    text-align: center;
    color: #8FA6AC;
    padding: 1.75rem 1.25rem;
    background: #2A4750;
    border: 1px solid #3B5860;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .flagged-group {
    margin-top: 1.1rem;
    background: #2A4750;
    border: 1px solid #3B5860;
    border-radius: 8px;
  }

  .flagged-group summary {
    cursor: pointer;
    padding: 0.8rem 1.1rem;
    color: #E8B4B0;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .flagged-group .mail-list { padding: 0 0.75rem 0.75rem; }
  .flagged-group .mail-row { background: #24404A; }

  @media (max-width: 768px) {
    .mail-content { padding: 1rem; }
    .mail-columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>

<%
  const fmtDate = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const isRecruiter = viewer === 'recruiter';
%>

<div class="mail-content">
  <div class="mail-header">
    <h1>Mail</h1>
    <p>
      Everything sent to you on PreCheckd, in one place.
      <% if (aliasAddress && isRecruiter) { %>Replies to your outreach arrive here. Your PreCheckd address is <span class="mail-address"><%= aliasAddress %></span>.<% } else if (aliasAddress) { %>Use <span class="mail-address"><%= aliasAddress %></span> on job applications instead of your real email.<% } %>
    </p>
  </div>

  <div class="mail-preview-note">
    <% if (isRecruiter) { %>Mail sent to your PreCheckd address is not forwarded to your real email. It stays here, and your daily email tells you when replies are waiting.<% } else { %>Mail sent to your PreCheckd address is no longer forwarded to your real email. It stays here, and your Monday and Thursday emails tell you when something is waiting.<% } %>
  </div>

  <% if (undo) { %>
    <div class="mail-banner ok">
      <span>Deleted: <strong><%= undo.subject %></strong></span>
      <form method="post" action="/mail/<%= undo.id %>/restore"><button type="submit" class="banner-btn">Undo</button></form>
    </div>
  <% } %>
  <% if (reported) { %>
    <div class="mail-banner ok"><span>Reported. That sender is blocked and their messages are hidden. Thank you for helping keep PreCheckd safe.</span></div>
  <% } %>

  <div class="mail-columns">
    <section class="mail-column verified-column">
      <h2><%= isRecruiter ? 'PreCheckd members' : 'Verified' %> <% if (leftUnread > 0) { %><span class="column-count"><%= leftUnread > 9 ? '9+' : leftUnread %></span><% } %></h2>
      <p class="column-note"><%= isRecruiter ? 'Candidates you are connected with on PreCheckd.' : 'Your PreCheckd connections and recruiters we have verified.' %></p>

      <% if (left.length === 0) { %>
        <div class="mail-empty"><%= isRecruiter ? 'Nothing here yet. Conversations with candidates you connect with will show up in this column.' : 'Nothing here yet. Conversations with your connections and mail from verified recruiters will show up in this column.' %></div>
      <% } else { %>
        <div class="mail-list">
          <% left.forEach(function(row) { %>
            <a href="<%= row.href %>" class="mail-row <%= row.unread ? 'unread' : '' %>">
              <div class="mail-row-top">
                <div class="mail-row-name"><%= row.name %><% if (row.kind === 'conversation' && row.unreadCount > 0) { %> <span class="column-count"><%= row.unreadCount %></span><% } %></div>
                <div class="mail-row-date"><%= fmtDate(row.at) %></div>
              </div>
              <% if (row.subject) { %><div class="mail-row-subject"><%= row.subject %></div><% } %>
              <div class="mail-row-preview"><%= row.preview %></div>
              <% if (row.trackerPending) { %><span class="row-tag verified">Tracker update waiting</span><% } %>
              <% if (row.kind === 'mail') { %>
                <span class="row-tag verified">&#10003; Verified recruiter<%= row.recruiterName ? ': ' + row.recruiterName : '' %></span>
              <% } else { %>
                <span class="row-tag member">PreCheckd conversation</span>
              <% } %>
            </a>
          <% }); %>
        </div>
      <% } %>
    </section>

    <section class="mail-column">
      <h2><%= isRecruiter ? 'Outside replies' : 'Not verified' %> <% if (rightUnread > 0) { %><span class="column-count quiet"><%= rightUnread > 9 ? '9+' : rightUnread %></span><% } %></h2>
      <p class="column-note"><%= isRecruiter ? 'Replies to your outreach and other mail from people who are not on PreCheckd. Be careful with links and attachments.' : 'We could not confirm who sent these. Be careful with links, attachments and requests for personal information.' %></p>

      <% if (right.length === 0) { %>
        <div class="mail-empty"><%= isRecruiter ? 'No replies yet. Answers to your outreach emails will show up here.' : 'No outside mail yet. Job application confirmations and other mail sent to your PreCheckd address will show up here.' %></div>
      <% } else { %>
        <div class="mail-list">
          <% right.forEach(function(row) { %>
            <a href="<%= row.href %>" class="mail-row <%= row.unread ? 'unread' : '' %>">
              <div class="mail-row-top">
                <div class="mail-row-name"><%= row.name %></div>
                <div class="mail-row-date"><%= fmtDate(row.at) %></div>
              </div>
              <div class="mail-row-subject"><%= row.subject %></div>
              <div class="mail-row-preview"><%= row.preview %></div>
              <% if (row.trackerPending) { %><span class="row-tag verified">Tracker update waiting</span><% } %>
              <% if (row.outreachReply) { %><span class="row-tag verified">Reply to your outreach</span><% } %>
              <% if (row.attachmentCount > 0) { %><span class="row-tag"><%= row.attachmentCount %> attachment<%= row.attachmentCount === 1 ? '' : 's' %></span><% } %>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (flagged.length > 0) { %>
        <details class="flagged-group">
          <summary>Flagged as suspicious (<%= flagged.length %>)</summary>
          <div class="mail-list">
            <% flagged.forEach(function(row) { %>
              <a href="<%= row.href %>" class="mail-row <%= row.unread ? 'unread' : '' %>">
                <div class="mail-row-top">
                  <div class="mail-row-name"><%= row.name %></div>
                  <div class="mail-row-date"><%= fmtDate(row.at) %></div>
                </div>
                <div class="mail-row-subject"><%= row.subject %></div>
                <div class="mail-row-preview"><%= row.preview %></div>
              </a>
            <% }); %>
          </div>
        </details>
      <% } %>
    </section>
  </div>
</div>
