<style>
  .ri-wrap { flex: 1; padding: 3rem 1.5rem; background: #1F363C; min-height: 70vh; display: flex; justify-content: center; }
  .ri-card { max-width: 560px; width: 100%; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 2rem; color: #F2F4F3; }
  .ri-card h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
  .ri-card p { color: #C7D1CF; line-height: 1.55; }
  .ri-card label { display: block; margin: 1rem 0 .3rem; font-weight: 600; }
  .ri-card input, .ri-card textarea { width: 100%; box-sizing: border-box; padding: .6rem; border-radius: 6px; border: 1px solid #5b7a82; background: #1F363C; color: #F2F4F3; font: inherit; }
  .ri-btn { margin-top: 1.2rem; background: #2ECC71; color: #10261b; border: 0; border-radius: 6px; padding: .75rem 1.3rem; font-weight: 800; cursor: pointer; font-size: 1rem; }
  .ri-err { background: #3a2020; border: 1px solid #7a3030; color: #f3c2c2; border-radius: 8px; padding: .7rem 1rem; margin-top: 1rem; }
  .ri-ok { background: #1d3b2a; border: 1px solid #2c6b45; color: #bdecd0; border-radius: 8px; padding: .9rem 1rem; }
  .ri-hp { position: absolute; left: -9999px; }
</style>
<div class="ri-wrap"><div class="ri-card">
  <h1>Request a founding invite</h1>
  <% if (done) { %>
    <div class="ri-ok">Thanks. We read every request ourselves. If a spot is available for you, we'll email you a personal link.</div>
  <% } else { %>
    <p>Founding invites are limited to 100 recruiters, and we review each request personally. Tell us a little about you and we'll get back to you by email.</p>
    <% if (error) { %><div class="ri-err"><%= error %></div><% } %>
    <form method="POST" action="/request-invite">
      <label for="ri-name">Your name</label>
      <input id="ri-name" name="name" maxlength="120" required value="<%= form.name || '' %>">
      <label for="ri-email">Work email</label>
      <input id="ri-email" name="email" type="email" maxlength="160" required value="<%= form.email || '' %>">
      <label for="ri-company">Company or agency (optional)</label>
      <input id="ri-company" name="company" maxlength="160" value="<%= form.company || '' %>">
      <label for="ri-about">What do you hire for? (optional)</label>
      <textarea id="ri-about" name="about" rows="3" maxlength="600"><%= form.about || '' %></textarea>
      <div class="ri-hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button class="ri-btn" type="submit">Request my invite</button>
      <p style="font-size:.85rem;margin-top:.8rem;">We only use these details to reply to your request.</p>
    </form>
  <% } %>
</div></div>
