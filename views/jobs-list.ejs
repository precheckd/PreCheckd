<style>
  .jl-wrap { flex: 1; padding: 2rem 1.5rem 4rem; background: #1F363C; min-height: 100vh; display: flex; justify-content: center; }
  .jl-inner { max-width: 1100px; width: 100%; color: #F2F4F3; }
  .jl-inner h1 { font-size: 1.75rem; margin: 0 0 0.3rem; }
  .jl-lead { color: #C7D1CF; margin-bottom: 1.25rem; }
  .jl-filter { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .jl-filter input, .jl-filter select { background: #2A4750; border: 1px solid #3B5860; color: #F2F4F3; border-radius: 6px; padding: 0.6rem 0.8rem; font-size: 0.95rem; }
  .jl-filter input { flex: 1; min-width: 180px; }
  .jl-filter button { background: #2ECC71; color: #10261C; border: 0; border-radius: 6px; padding: 0.6rem 1.2rem; font-weight: 700; cursor: pointer; }
  .jl-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0.9rem; align-items: start; }
  .jl-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .jl-bar .jl-tabs { margin-bottom: 0; }
  .jl-card { position: relative; display: block; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 0.8rem; text-decoration: none; color: #F2F4F3; }
  .jl-card:hover { border-color: #2ECC71; }
  .jl-title { font-weight: 700; font-size: 1.05rem; }
  .jl-sub { color: #C7D1CF; font-size: 0.88rem; margin-top: 0.2rem; }
  .jl-skills { color: #8FA6AC; font-size: 0.82rem; margin-top: 0.35rem; }
  .jl-title a { color: inherit; text-decoration: none; }
  .jl-title a::after { content: ''; position: absolute; inset: 0; }
  .jl-fix { position: relative; z-index: 2; color: #2ECC71; font-weight: 700; text-decoration: underline; }
  .jl-empty { color: #C7D1CF; background: #2A4750; border: 1px dashed #4A6F7B; border-radius: 8px; padding: 2rem; text-align: center; }
  .jl-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .jl-tab { background: #2A4750; border: 1px solid #3B5860; color: #C7D1CF; border-radius: 999px; padding: 0.4rem 1rem; text-decoration: none; font-size: 0.9rem; font-weight: 600; }
  .jl-tab.is-on { background: #2ECC71; border-color: #2ECC71; color: #10261C; }
  .jl-badge { display: inline-block; font-size: 0.75rem; font-weight: 700; border-radius: 999px; padding: 0.1rem 0.6rem; margin-left: 0.5rem; vertical-align: middle; }
  .jl-badge.fit { background: #1E3B2C; color: #2ECC71; border: 1px solid #2ECC71; }
  .jl-badge.applied { background: #24404A; color: #C7D1CF; border: 1px solid #4A6F7B; }
  .jl-card.is-blocked .jl-title, .jl-card.is-blocked .jl-sub, .jl-card.is-blocked .jl-skills { opacity: 0.72; }
  .jl-why { color: #E0B341; font-size: 0.82rem; margin-top: 0.4rem; }
  .jl-note { color: #8FA6AC; font-size: 0.8rem; margin-top: 0.5rem; }
</style>
<div class="jl-wrap"><div class="jl-inner">
  <h1>Open jobs</h1>
  <p class="jl-lead">Every applicant here has a verified identity, tested skills and verified credentials. <%= totalOpen %> open <%= totalOpen === 1 ? 'job' : 'jobs' %>.</p>
  <form class="jl-filter" method="get" action="/jobs">
    <% if (viewer) { %><input type="hidden" name="view" value="<%= viewer.view %>"><% } %>
    <input type="search" name="q" value="<%= q %>" maxlength="100" placeholder="Title, company, skill or place" aria-label="Search jobs">
    <select name="arrangement" aria-label="Work arrangement">
      <option value="">Any arrangement</option>
      <% options.arrangements.forEach(function(a) { %><option value="<%= a.code %>"<%= arrangement === a.code ? ' selected' : '' %>><%= a.label %></option><% }); %>
    </select>
    <button type="submit">Search</button>
  </form>
  <% if (viewer) {
       var tabHref = function(v) { var u = '/jobs?view=' + v + (q ? '&q=' + encodeURIComponent(q) : '') + (arrangement ? '&arrangement=' + arrangement : ''); return u; }; %>
  <% } %>
  <div class="jl-bar">
    <% if (viewer) { %>
    <div class="jl-tabs">
      <a class="jl-tab <%= viewer.view === 'fit' ? 'is-on' : '' %>" href="<%= tabHref('fit') %>">Jobs for you (<%= viewer.counts.fit + viewer.counts.applied %>)</a>
      <a class="jl-tab <%= viewer.view === 'area' ? 'is-on' : '' %>" href="<%= tabHref('area') %>">In my work area (<%= viewer.counts.area %>)</a>
      <a class="jl-tab <%= viewer.view === 'all' ? 'is-on' : '' %>" href="<%= tabHref('all') %>">All open jobs (<%= viewer.counts.all %>)</a>
    </div>
    <% } else { %><div></div><% } %>
  </div>
  <% if (jobs.length === 0) { %>
    <div class="jl-empty"><%= totalOpen === 0 ? 'No jobs are open right now. Check back soon.' : (viewer && viewer.view === 'fit' && !q && !arrangement ? 'None of the open jobs match your profile yet. Open the All open jobs tab to see what each one needs.' : viewer && viewer.view === 'area' ? 'No open jobs fall inside your Work Areas yet. Remote jobs are listed under Jobs for you and All open jobs.' : 'No open jobs match that search.') %></div>
  <% } else { %>
  <div class="jl-cards">
      <% jobs.forEach(function(j) { %>
        <div class="jl-card <%= j.fit && j.fit.status === 'blocked' ? 'is-blocked' : '' %>">
          <div class="jl-title"><a href="<%= j.path %>"><%= j.title %></a><% if (j.fit && j.fit.status === 'fit') { %><span class="jl-badge fit">You qualify</span><% } else if (j.fit && j.fit.status === 'applied') { %><span class="jl-badge applied">Applied</span><% } %></div>
          <div class="jl-sub"><%= j.hiringCompany %> &middot; <%= j.location %></div>
          <div class="jl-sub"><%= j.payLine %> &middot; <%= j.seniorityLabel %></div>
          <div class="jl-skills"><%= j.skills.map(function(s) { return s.label + (s.minLevel ? ' (' + s.minLevel + ')' : ''); }).join(' · ') %></div>
          <% if (j.fit && j.fit.status === 'blocked') { %><div class="jl-why">To apply: <% j.fit.reasons.forEach(function(r, i) { %><%= i ? ' · ' : '' %><% if (r.href) { %><a class="jl-fix" href="<%= r.href %>"><%= r.text %></a><% } else { %><%= r.text %><% } %><% }); %></div><% } %>
        </div>
      <% }); %>
  </div>
  <% } %>
</div></div>
