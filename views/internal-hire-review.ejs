<style>
  .sr-wrap { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .sr-wrap h1 { color: #1F363C; font-size: 1.6rem; margin-bottom: 0.4rem; }
  .sr-sub { color: #7A8B91; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5; }
  .sr-back { color: #1F7A4C; font-size: 0.9rem; text-decoration: none; display: inline-block; margin-bottom: 1rem; }
  .sr-table { width: 100%; border-collapse: collapse; background: #F7F9F8; border: 1px solid #DCE4E2; border-radius: 8px; overflow: hidden; }
  .sr-table th { text-align: left; background: #1F363C; color: #F2F4F3; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.75rem 1rem; }
  .sr-table td { padding: 0.75rem 1rem; border-top: 1px solid #DCE4E2; color: #1F363C; font-size: 0.92rem; }
  .sr-btn { border: 1px solid #1F7A4C; color: #1F7A4C; background: transparent; border-radius: 5px; padding: 0.3rem 0.65rem; font-size: 0.8rem; cursor: pointer; }
</style>
<div class="sr-wrap">
  <a class="sr-back" href="/">&larr; Dashboard</a>
  <h1>Hire Review</h1>
  <p class="sr-sub">Jobs where a reported hire needs a look: a named hire said they were <strong>not</strong> hired, a job was reposted soon after a cancellation, or a "hired elsewhere" email has gone unanswered for a week. Check the recruiter's other outcomes, then press Clear to take the flag off.</p>
  <table class="sr-table">
    <thead><tr><th>Job</th><th>Flag</th><th>Unanswered</th><th>Denied</th><th>Expired</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach((r) => { %>
        <tr>
          <td><%= r.title %> at <%= r.company %><div style="color:#7A8B91;font-size:0.8rem;">recruiter <%= r.recruiterId %></div></td>
          <td><%= r.flag === 'hire_denied' ? 'Named hire said no' : r.flag === 'repost_after_cancel' ? 'Reposted after cancelling' : '' %></td>
          <td><%= r.pending %></td><td><%= r.denied %></td><td><%= r.expired %></td>
          <td><% if (r.flag) { %>
            <form method="POST" action="/hire-review/<%= r.id %>/clear"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sr-btn" type="submit">Clear flag</button></form>
          <% } %></td>
        </tr>
      <% }) %>
      <% if (!rows.length) { %><tr><td colspan="6">Nothing needs review.</td></tr><% } %>
    </tbody>
  </table>
</div>
