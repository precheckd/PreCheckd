<style>
  .rq-group { margin-bottom: 1.5rem; }
  .rq-title { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #8FA6AC; margin-bottom: 0.5rem; }
  .rq-row { display: flex; align-items: center; gap: 0.75rem; background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 0.6rem 0.85rem; margin-bottom: 0.45rem; }
  .rq-av { width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0; overflow: hidden; background: #2ECC71; color: #1F363C; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; }
  .rq-av img { width: 100%; height: 100%; object-fit: cover; }
  .rq-main { flex: 1; min-width: 0; }
  .rq-name { color: #F2F4F3; font-weight: 600; font-size: 0.95rem; }
  .rq-meta { color: #8FA6AC; font-size: 0.8rem; font-weight: 400; margin-left: 0.4rem; }
  .rq-note { color: #C7D1CF; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rq-hint { color: #8FA6AC; font-size: 0.78rem; }
  .rq-actions { display: flex; gap: 0.4rem; flex-shrink: 0; align-items: center; }
  .rq-actions form { margin: 0; }
  .rq-btn { border: 1px solid #4A6F7B; background: transparent; color: #C7D1CF; font-size: 0.82rem; font-weight: 600; padding: 0.35rem 0.85rem; border-radius: 6px; cursor: pointer; font-family: inherit; width: auto; }
  .rq-btn.go { background: #2ECC71; border-color: #2ECC71; color: #1F363C; }
  .rq-tag { font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; background: #3B5F6A; color: #B9C7CA; white-space: nowrap; }
  .rq-empty { color: #8FA6AC; padding: 2rem 0; }
  .rq-empty a { color: #4ADE80; font-weight: 600; text-decoration: none; }
  @media (max-width: 768px) { .rq-row { flex-wrap: wrap; } .rq-actions { width: 100%; } }
</style>

<%
  const fmt = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  const jobsLine = (c) => (c.workHistory || []).slice(0, 2).map((j) => j.jobTitle).filter(Boolean).join(' · ');
%>
<% if (waitingOnYou.length === 0 && waitingOnThem.length === 0) { %>
  <div class="rq-empty">Nothing waiting. <a href="/candidate-search">Find candidates</a> to send a request, or see who you're connected with on the Connections tab.</div>
<% } %>

<% if (waitingOnYou.length > 0) { %>
  <div class="rq-group">
    <div class="rq-title">Waiting on you</div>
    <% waitingOnYou.forEach(function (request) { const c = request.candidate; %>
      <div class="rq-row" id="request-<%= request._id %>">
        <% if (c.photoUrl) { %><div class="rq-av"><img src="<%= c.photoUrl %>" alt=""></div><% } else { %><div class="rq-av">?</div><% } %>
        <div class="rq-main">
          <div class="rq-name"><%= c.displayName %><span class="rq-meta"><%= jobsLine(c) ? jobsLine(c) + ' · ' : '' %><%= fmt(request.createdAt) %></span></div>
          <% if (request.note) { %><div class="rq-note" title="<%= request.note %>"><%= request.note %></div><% } %>
          <div class="rq-hint">Identity and employer names are hidden until you respond.</div>
        </div>
        <div class="rq-actions">
          <form action="/recruiter-dashboard/requests/<%= request._id %>/accept" method="POST"><button class="rq-btn go" type="submit">Accept</button></form>
          <form action="/recruiter-dashboard/requests/<%= request._id %>/decline" method="POST"><button class="rq-btn" type="submit">Decline</button></form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (waitingOnThem.length > 0) { %>
  <div class="rq-group">
    <div class="rq-title">Waiting for a reply</div>
    <% waitingOnThem.forEach(function (request) { const c = request.candidate; %>
      <div class="rq-row" id="request-<%= request._id %>">
        <% if (c.photoUrl) { %><div class="rq-av"><img src="<%= c.photoUrl %>" alt=""></div><% } else { %><div class="rq-av"><%= request.status === 'pending' ? '?' : c.displayName.charAt(0) %></div><% } %>
        <div class="rq-main">
          <div class="rq-name"><%= c.displayName %><span class="rq-meta"><%= request.status === 'accepted' ? 'Full access requested' : 'Sent ' + fmt(request.createdAt) %></span></div>
        </div>
        <div class="rq-actions"><span class="rq-tag">Pending</span></div>
      </div>
    <% }); %>
  </div>
<% } %>
