<style>
  .claim-content {
    flex: 1;
    padding: 2rem 1.5rem;
    background: #1F363C;
    min-height: 100vh;
  }

  .claim-header {
    max-width: 800px;
    margin: 0 auto 1.5rem;
  }

  .claim-header h1 {
    font-size: 1.75rem;
    color: #F2F4F3;
    margin-bottom: 0.35rem;
  }

  .claim-header p {
    color: #C7D1CF;
    font-size: 0.95rem;
  }

  .claim-section {
    max-width: 800px;
    margin: 0 auto 1.5rem;
  }

  .claim-section h2 {
    font-size: 1.1rem;
    color: #F2F4F3;
    margin-bottom: 0.75rem;
  }

  .report-card {
    background: #2A4750;
    border: 1px solid #3B5860;
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .report-card .report-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    color: #8FA6AC;
  }

  .report-category {
    display: inline-block;
    background: #3A2020;
    color: #FF8A8A;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .report-card p {
    color: #E8EBEA;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .no-reports {
    background: #2A4750;
    border: 1px solid #3B5860;
    border-radius: 8px;
    padding: 1.25rem;
    color: #C7D1CF;
    font-size: 0.9rem;
  }

  .locked-list {
    background: #2A4750;
    border: 1px solid #3B5860;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .locked-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    color: #8FA6AC;
    font-size: 0.95rem;
    border-bottom: 1px solid #3B5860;
  }

  .locked-item:last-child {
    border-bottom: none;
  }

  .locked-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: #5C7278;
  }

  .unlock-cta {
    background: #2A4750;
    border: 1px solid #2ECC71;
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
  }

  .unlock-cta h2 {
    color: #F2F4F3;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .unlock-cta p {
    color: #C7D1CF;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .unlock-cta button {
    padding: 0.75rem 1.5rem;
    background: #5C7278;
    color: #B9C7CA;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: not-allowed;
  }

  .unlock-cta .coming-soon {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: #8FA6AC;
  }
</style>

<div class="claim-content">
  <div class="claim-header">
    <h1>Your PreCheckd account</h1>
    <p>This is everything available on this account right now.</p>
  </div>

  <div class="claim-section">
    <h2>Feedback reported about you</h2>
    <% if (reports.length === 0) { %>
      <div class="no-reports">No reports on file.</div>
    <% } else { %>
      <% reports.forEach((report) => { %>
        <div class="report-card">
          <div class="report-meta">
            <span class="report-category"><%= report.reasonCategory.replace(/-/g, ' ') %></span>
            <span>Reported <%= new Date(report.createdAt).toLocaleDateString() %></span>
          </div>
          <p><%= report.description %></p>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="claim-section">
    <h2>Locked</h2>
    <div class="locked-list">
      <div class="locked-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Respond to this feedback
      </div>
      <div class="locked-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Build your public profile
      </div>
      <div class="locked-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Message and connect with candidates
      </div>
      <div class="locked-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Appear in recruiter search
      </div>
    </div>
  </div>

  <div class="claim-section unlock-cta">
    <h2>Verify your identity to unlock your account</h2>
    <p>Verification confirms it's really you — then everything above opens up.</p>
    <button type="button" disabled>Verify &amp; unlock</button>
    <span class="coming-soon">Coming soon</span>
  </div>
</div>
