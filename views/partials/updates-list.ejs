<% const empty = isCandidate
     ? 'Nothing yet. When a recruiter you\'re connected to posts a job you qualify for, it shows up here.'
     : 'Nothing yet. When a connected candidate earns a verified certification or degree, or reaches a skill level, it shows up here (candidates choose whether to share).'; %>
<style>
  .upd-list { list-style: none; margin: 0; padding: 0; }
  .upd-item { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-top: 1px solid #3B5860; color: #E8EBEA; font-size: 0.95rem; }
  .upd-item:first-child { border-top: 0; }
  .upd-item.is-new { font-weight: 600; }
  .upd-item a { color: #4ADE80; text-decoration: none; }
  .upd-ago { color: #8FA6AC; font-size: 0.8rem; white-space: nowrap; font-weight: 400; }
  .upd-card { background: #2A4750; border: 1px solid #3B5860; border-radius: 8px; padding: 1rem 1.25rem; margin: 1rem 0; }
  .upd-card h2 { font-size: 1.05rem; color: #F2F4F3; margin: 0 0 0.4rem; }
</style>
<% const shown = full ? feed.items : feed.items.slice(0, 5); %>
<div class="<%= full ? '' : 'upd-card' %>">
  <% if (!full) { %><h2>Latest updates</h2><% } %>
  <% if (!shown.length) { %>
    <p style="color:#C7D1CF;font-size:0.92rem;margin:0;"><%= empty %></p>
  <% } else { %>
    <ul class="upd-list">
      <% shown.forEach((i) => { %>
        <li class="upd-item<%= i.unread ? ' is-new' : '' %>">
          <span><%= i.text %><% if (i.url && i.kind === 'new_job') { %> <a href="<%= i.url %>">View job</a><% } %></span>
          <span class="upd-ago"><%= i.ago %></span>
        </li>
      <% }) %>
    </ul>
    <% if (!full) { %><p style="margin:0.6rem 0 0;"><a href="/connections?tab=updates" style="color:#4ADE80;font-size:0.88rem;text-decoration:none;">See all updates</a></p><% } %>
  <% } %>
</div>
