<style>
  .sg-page { flex: 1; padding: 1.75rem 1.5rem; background: #1F363C; min-height: 100vh; }
  .sg-inner { max-width: 820px; margin: 0 auto; }
  .sg-inner h1 { font-size: 1.6rem; color: #F2F4F3; margin-bottom: 0.3rem; }
  .sg-sub { color: #8FA6AC; font-size: 0.92rem; margin-bottom: 1.25rem; line-height: 1.5; }
  .sg-card { background: #2A4750; border: 1px solid #3B5860; border-radius: 10px; padding: 1.25rem; margin-bottom: 1rem; }
  .sg-card h2 { font-size: 1.05rem; color: #F2F4F3; margin-bottom: 0.6rem; }
  .sg-card p { color: #C7D1CF; font-size: 0.92rem; line-height: 1.55; margin-bottom: 0.8rem; }
  .sg-preview { background: #FFFFFF; border-radius: 8px; padding: 1.1rem 1.25rem; margin: 0.6rem 0 1rem; overflow-x: auto; }
  .sg-row { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .sg-btn { background: #2ECC71; color: #12262B; border: 0; border-radius: 6px; padding: 0.6rem 1.1rem; font-weight: 700; font-size: 0.92rem; cursor: pointer; text-decoration: none; display: inline-block; }
  .sg-btn.alt { background: transparent; color: #4ADE80; border: 1px solid #2ECC71; }
  .sg-btn.alt:hover { background: #24404A; color: #F2F4F3; }
  .sg-line-form { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: end; margin-bottom: 0.4rem; }
  .sg-line-form label { display: block; color: #C7D1CF; font-size: 0.8rem; margin-bottom: 0.25rem; }
  .sg-line-form input { background: #1F363C; color: #F2F4F3; border: 1px solid #3B5860; border-radius: 6px; padding: 0.55rem 0.7rem; width: 320px; max-width: 100%; font-size: 0.92rem; }
  .sg-ok { padding: 0.7rem 1rem; border-radius: 8px; background: #1E4A33; border: 1px solid #2ECC71; color: #BDF2D2; font-size: 0.92rem; margin-bottom: 1rem; }
  .sg-copied { color: #4ADE80; font-size: 0.85rem; margin-left: 0.4rem; align-self: center; }
  .sg-steps li { color: #C7D1CF; font-size: 0.9rem; line-height: 1.6; margin-left: 1.1rem; }
  .sg-steps strong { color: #F2F4F3; }
  pre.sg-text { background: #1F363C; border: 1px solid #3B5860; border-radius: 6px; color: #E8EBEA; padding: 0.7rem 0.9rem; font-size: 0.85rem; white-space: pre-wrap; word-break: break-all; }
  @media (max-width: 768px) { .sg-page { padding: 1rem; } }
</style>

<div class="sg-page">
  <div class="sg-inner">
    <h1>Email signature</h1>
    <p class="sg-sub">A signature with a "Verified by PreCheckd" badge that links to your <%= kind === 'candidate' ? 'public verification page' : 'verified recruiter profile' %>, so anyone who gets your email can check you out. If your status ever changes, the badge stops showing on its own.</p>

    <% if (enabledNow) { %><div class="sg-ok">Your public verification page is on. Your signature is ready below.</div><% } %>

    <% if (!el.ok && el.reason === 'public_off') { %>
      <div class="sg-card">
        <h2>Turn on your public verification page first</h2>
        <p>Your signature links to your public verification page, which shows only your first name and last initial, your identity and phone checks, and any sections you choose to show. It's currently off. You can change what it shows, or turn it off again, any time from Edit profile.</p>
        <form method="post" action="/signature/enable-public"><button type="submit" class="sg-btn">Turn it on and get my signature</button></form>
      </div>
    <% } else if (!el.ok) { %>
      <div class="sg-card">
        <h2>Finish verifying first</h2>
        <p>The signature is available once your identity and phone are verified<%= kind === 'recruiter' ? ' and your account is active' : '' %>. Finish those steps on your profile and come back.</p>
      </div>
    <% } else { %>
      <div class="sg-card">
        <h2>Your signature</h2>
        <form method="get" action="/signature" class="sg-line-form">
          <div><label for="sg-line"><%= kind === 'recruiter' ? 'Title and company (optional)' : 'A line under your name (optional, like your title)' %></label>
            <input id="sg-line" type="text" name="line" maxlength="90" value="<%= line %>" placeholder="<%= kind === 'recruiter' ? 'Senior Recruiter, Acme' : 'Support Engineer' %>"></div>
          <button type="submit" class="sg-btn alt">Update preview</button>
        </form>
        <div class="sg-preview" id="sg-preview"><%- built.html %></div>
        <div class="sg-row">
          <button type="button" class="sg-btn" id="sg-copy">Copy signature</button>
          <button type="button" class="sg-btn alt" id="sg-copy-text">Copy plain text version</button>
          <a class="sg-btn alt" href="/signature/download.html?line=<%= encodeURIComponent(line) %>">Download .html</a>
          <span class="sg-copied" id="sg-copied" hidden></span>
        </div>
      </div>

      <div class="sg-card">
        <h2>How to add it</h2>
        <ul class="sg-steps">
          <li><strong>Gmail:</strong> Settings, See all settings, General, Signature. Create a new one, click in the box, and paste (Ctrl+V or Cmd+V).</li>
          <li><strong>Outlook:</strong> Settings, Accounts, Signatures (or File, Options, Mail, Signatures on desktop). Create a new one and paste.</li>
          <li><strong>Apple Mail:</strong> Settings, Signatures, create one, turn off "Always match my default message font", and paste.</li>
        </ul>
        <p style="margin-top:0.8rem">Some mail programs only allow plain text. Use the plain text version there.</p>
        <pre class="sg-text" id="sg-text"><%= built.text %></pre>
      </div>
    <% } %>
  </div>
</div>

<% if (el.ok) { %>
<script>
  (function () {
    var note = document.getElementById('sg-copied');
    function say(msg) { note.textContent = msg; note.hidden = false; setTimeout(function () { note.hidden = true; }, 2500); }
    document.getElementById('sg-copy').addEventListener('click', function () {
      var el = document.getElementById('sg-preview');
      var range = document.createRange(); range.selectNodeContents(el);
      var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) {}
      sel.removeAllRanges();
      say(ok ? 'Copied. Paste it into your email settings.' : 'Could not copy. Select the signature and copy it by hand.');
    });
    document.getElementById('sg-copy-text').addEventListener('click', function () {
      var text = document.getElementById('sg-text').textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () { say('Copied.'); }, function () { say('Could not copy.'); });
      } else { say('Select the text and copy it by hand.'); }
    });
  })();
</script>
<% } %>
