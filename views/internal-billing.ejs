<style>
  .sr-wrap { max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem 4rem; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .sr-wrap h1 { color: #1F363C; font-size: 1.6rem; margin-bottom: 0.4rem; }
  .sr-wrap h2 { color: #1F363C; font-size: 1.1rem; margin: 1.8rem 0 0.6rem; }
  .sr-sub { color: #7A8B91; font-size: 0.9rem; margin-bottom: 1.2rem; line-height: 1.5; }
  .sr-back { color: #1F7A4C; font-size: 0.9rem; text-decoration: none; display: inline-block; margin-bottom: 1rem; }
  .sr-table { width: 100%; border-collapse: collapse; background: #F7F9F8; border: 1px solid #DCE4E2; border-radius: 8px; overflow: hidden; }
  .sr-table th { text-align: left; background: #1F363C; color: #F2F4F3; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.7rem 1rem; }
  .sr-table td { padding: 0.65rem 1rem; border-top: 1px solid #DCE4E2; color: #1F363C; font-size: 0.9rem; }
  .sr-warn { background: #FFF4D6; border: 1px solid #E8D28A; color: #6b5200; padding: 0.6rem 1rem; border-radius: 8px; margin-bottom: 1rem; }
</style>
<%
  const d = (x) => x ? new Date(x).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }) : '';
  const t = (x) => x ? new Date(x).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }) : '';
%>
<div class="sr-wrap">
  <a class="sr-back" href="/">&larr; Dashboard</a>
  <h1>Billing</h1>
  <% if (!enabled) { %><div class="sr-warn">BILLING_ENABLED is off. Nobody is being charged or blocked.</div><% } %>
  <p class="sr-sub">Counts come from the membership record on each account, which the Stripe webhook keeps current. Stripe is the source of truth for money.</p>

  <h2>Members by status</h2>
  <table class="sr-table">
    <thead><tr><th></th><% data.recruiters && Object.keys(data.recruiters).forEach((s) => { %><th><%= s.replace('_', ' ') %></th><% }) %></tr></thead>
    <tbody>
      <tr><td>Recruiters</td><% Object.keys(data.recruiters).forEach((s) => { %><td><%= data.recruiters[s] %></td><% }) %></tr>
      <tr><td>Candidates</td><% Object.keys(data.candidates).forEach((s) => { %><td><%= data.candidates[s] %></td><% }) %></tr>
    </tbody>
  </table>

  <h2>Founding spots</h2>
  <table class="sr-table">
    <thead><tr><th>Group</th><th>Price</th><th>Taken</th><th>Left</th></tr></thead>
    <tbody>
      <% data.waves.forEach((w) => { %><tr><td>Recruiter wave <%= w.wave %></td><td>$<%= w.price %>/yr</td><td><%= w.taken %> of <%= w.size %></td><td><%= w.size - w.taken %></td></tr><% }) %>
      <tr><td>Founding candidates (no $79 fee)</td><td>free fee</td><td><%= data.candidateFounding.size - data.candidateFounding.left %> of <%= data.candidateFounding.size %></td><td><%= data.candidateFounding.left %></td></tr>
    </tbody>
  </table>

  <h2>Payment trouble (access ends when the grace date passes)</h2>
  <table class="sr-table">
    <thead><tr><th>Who</th><th>Type</th><th>Plan</th><th>Status</th><th>Grace ends</th></tr></thead>
    <tbody>
      <% data.trouble.forEach((r) => { %><tr><td><%= r.name || r.email %><br><small><%= r.email %></small></td><td><%= r.type %></td><td><%= r.plan || '' %></td><td><%= r.status.replace('_', ' ') %></td><td><%= d(r.graceUntil) %></td></tr><% }) %>
      <% if (!data.trouble.length) { %><tr><td colspan="5">None.</td></tr><% } %>
    </tbody>
  </table>

  <h2>Cancelling at the end of their period</h2>
  <table class="sr-table">
    <thead><tr><th>Who</th><th>Type</th><th>Plan</th><th>Ends</th></tr></thead>
    <tbody>
      <% data.leaving.forEach((r) => { %><tr><td><%= r.name || r.email %><br><small><%= r.email %></small></td><td><%= r.type %></td><td><%= r.plan || '' %></td><td><%= d(r.periodEnd) %></td></tr><% }) %>
      <% if (!data.leaving.length) { %><tr><td colspan="4">None.</td></tr><% } %>
    </tbody>
  </table>

  <h2>Latest Stripe events handled</h2>
  <table class="sr-table">
    <thead><tr><th>When</th><th>Event</th><th>Who</th><th>Note</th></tr></thead>
    <tbody>
      <% data.events.forEach((e) => { %><tr><td><%= t(e.at) %></td><td><%= e.type %></td><td><%= e.ownerType || '' %></td><td><%= e.note || '' %></td></tr><% }) %>
      <% if (!data.events.length) { %><tr><td colspan="4">None yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
