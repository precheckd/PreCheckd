<style>
  .sr-wrap { max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem 4rem; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .sr-wrap h1 { color: #1F363C; font-size: 1.6rem; margin-bottom: 0.4rem; }
  .sr-sub { color: #7A8B91; font-size: 0.9rem; margin-bottom: 1rem; line-height: 1.5; }
  .sr-back { color: #1F7A4C; font-size: 0.9rem; text-decoration: none; display: inline-block; margin-bottom: 1rem; }
  .cl-stats { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .cl-stat { background: #F7F9F8; border: 1px solid #DCE4E2; border-radius: 8px; padding: 0.6rem 1rem; color: #1F363C; font-size: 0.9rem; }
  .cl-stat strong { display: block; font-size: 1.2rem; }
  .cl-filter a { color: #1F7A4C; margin-right: 1rem; font-size: 0.9rem; }
  .cl-row { border: 1px solid #DCE4E2; border-radius: 8px; background: #F7F9F8; padding: 0.75rem 1rem; margin-top: 0.75rem; color: #1F363C; font-size: 0.92rem; }
  .cl-meta { color: #7A8B91; font-size: 0.78rem; margin-bottom: 0.3rem; }
  .cl-q { font-weight: 600; }
  .cl-a { margin-top: 0.3rem; white-space: pre-wrap; }
  .cl-tag { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 0.05rem 0.45rem; border-radius: 999px; margin-left: 0.4rem; }
  .cl-gap { background: #FDECC8; color: #7A5200; }
  .cl-fail { background: #F8D7D7; color: #8A1F1F; }
</style>
<div class="sr-wrap">
  <a class="sr-back" href="/">&larr; Dashboard</a>
  <h1>Assistant Chats</h1>
  <p class="sr-sub">Every question asked on /ask (kept 90 days, no account attached). <strong>Couldn't answer</strong> means the assistant said it didn't have the information: add the answer to <code>src/content/chatKnowledge.md</code> and deploy. <strong>Failed</strong> means the visitor saw the fallback message.</p>
  <div class="cl-stats">
    <div class="cl-stat"><strong>$<%= spent24h.toFixed(3) %> of $<%= cap.toFixed(2) %></strong>spent, last 24 hours (cap)</div>
    <div class="cl-stat"><strong><%= count24h %></strong>questions, last 24 hours</div>
    <div class="cl-stat"><strong><%= total %></strong>questions saved</div>
  </div>
  <p class="cl-filter"><a href="/chat-logs">All questions</a><a href="/chat-logs?gaps=1">Only couldn't answer / failed</a></p>
  <% rows.forEach((r) => { %>
    <div class="cl-row">
      <div class="cl-meta"><%= new Date(r.createdAt).toLocaleString('en-US', { timeZone: 'America/New_York' }) %> ET &middot; visitor <%= r.visitorHash.slice(0, 6) %>
        <% if (r.noAnswer) { %><span class="cl-tag cl-gap">Couldn't answer</span><% } %>
        <% if (r.failed) { %><span class="cl-tag cl-fail">Failed</span><% } %>
      </div>
      <div class="cl-q"><%= r.question %></div>
      <% if (r.answer) { %><div class="cl-a"><%= r.answer %></div><% } %>
    </div>
  <% }) %>
  <% if (!rows.length) { %><p class="sr-sub" style="margin-top:1rem;">Nothing yet.</p><% } %>
</div>
