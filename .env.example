# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/precheckd

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_FOUNDING_RECRUITER_PRICE_ID=price_xxx

# Sumsub
SUMSUB_APP_TOKEN=sbx:xxx
SUMSUB_SECRET_KEY=xxx
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=founding-recruiter-kyc
SUMSUB_WEBHOOK_SECRET=xxx

# AWS SMS (Pinpoint SMS/Voice v2 "Notify" templates) — recruiter/candidate
# phone verification, and the internal-admin login 2FA code
AWS_SMS_REGION=us-east-1
AWS_SMS_ACCESS_KEY_ID=xxx
AWS_SMS_SECRET_ACCESS_KEY=xxx
AWS_NOTIFY_CONFIGURATION_ID=xxx
AWS_NOTIFY_TEMPLATE_ID=xxx
MOCK_SMS=true

# Internal admin dashboard
INTERNAL_ADMIN_SECRET=xxx
# Hostname the internal dashboard is served on in production; falls back to
# the /internal path locally so it's reachable without custom DNS in dev.
ADMIN_HOSTNAME=admin.precheckd.com
