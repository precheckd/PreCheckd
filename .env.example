# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/precheckd

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_FOUNDING_RECRUITER_PRICE_ID=price_xxx

# Sumsub
SUMSUB_APP_TOKEN=sbx:xxx
SUMSUB_SECRET_KEY=xxx
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=founding-recruiter-kyc
SUMSUB_WEBHOOK_SECRET=xxx

# AWS SMS (Pinpoint SMS/Voice v2 "Notify" templates) — recruiter/candidate
# phone verification, and the internal-admin login 2FA code
AWS_SMS_REGION=us-east-1
AWS_SMS_ACCESS_KEY_ID=xxx
AWS_SMS_SECRET_ACCESS_KEY=xxx
AWS_NOTIFY_CONFIGURATION_ID=xxx
AWS_NOTIFY_TEMPLATE_ID=xxx
MOCK_SMS=true

# Internal admin dashboard
INTERNAL_ADMIN_SECRET=xxx
# Hostname the internal dashboard is served on in production; falls back to
# the /internal path locally so it's reachable without custom DNS in dev.
ADMIN_HOSTNAME=admin.precheckd.com

# Google Analytics 4 — public site tracking + a server-side pull of daily
# page views into the internal dashboard's traffic chart.
# GA_MEASUREMENT_ID: the gtag.js "G-XXXXXXX" ID (GA4 property > Data Streams)
# GA_PROPERTY_ID: the numeric property ID (GA4 property > Admin > Property Settings)
# GA_CLIENT_EMAIL / GA_PRIVATE_KEY: a service account with Viewer access on
#   the property (Google Cloud Console > enable the Analytics Data API >
#   create a service account + JSON key); paste the key's "client_email" and
#   "private_key" fields here (escape the key's newlines as \n)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=xxx
GA_CLIENT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
